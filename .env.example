# Database
DATABASE_URL=mysql+pymysql://writoauth:password@mysql:3306/writoauth_db
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=writoauth_db
MYSQL_USER=writoauth
MYSQL_PASSWORD=password

# Authentication
# Required - the app fails to start without this set (no hardcoded default).
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# AI Models
# EMBEDDING_MODEL: fastembed model run in-process (no separate service)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ANALYSIS_FLAG_THRESHOLD: 0-100 consistency score below which a submission
# is flagged for teacher review
ANALYSIS_FLAG_THRESHOLD=75.0

# Frontend
# When running in Docker: browser -> backend uses localhost:8000
# When container -> container: use http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
