# Database
DATABASE_URL=postgresql+psycopg://writoauth:password@postgres:5432/writoauth_db
POSTGRES_USER=writoauth
POSTGRES_PASSWORD=password
POSTGRES_DB=writoauth_db

# Authentication
# Required - the app fails to start without this set (no hardcoded default).
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# AI Models
# NEURAL_STYLE_ENABLED: run the LUAR neural authorship model (downloads
# ~330 MB into the hf_cache volume on first start). false = score with the
# six stylometric profiles only.
NEURAL_STYLE_ENABLED=true
# Model + pinned commit. Only change these together, deliberately - the
# model ships custom code, so the revision must be a reviewed commit sha.
# NEURAL_STYLE_MODEL=rrivera1849/LUAR-MUD
# NEURAL_STYLE_REVISION=f1db50251805ed69b43cf4f72ea2f0e231f36a1c
# ANALYSIS_FLAG_THRESHOLD: 0-100 consistency score below which a submission
# is flagged for teacher review
ANALYSIS_FLAG_THRESHOLD=75.0

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend
# When running in Docker: browser -> backend uses localhost:8000
# When container -> container: use http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
